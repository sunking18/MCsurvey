# ========== 问卷系统 Docker 部署环境变量 ==========
# 复制此文件为 .env 并填入真实值：cp .env.example .env

# ----- 数据导出密钥（管理员在 /admin.html 输入）-----
EXPORT_KEY=admin123

# ----- MySQL 数据库 -----
MYSQL_ROOT_PASSWORD=Survey@2026!Secure
MYSQL_DATABASE=survey
MYSQL_USER=survey
MYSQL_PASSWORD=SurveyDb@2026

# ----- 微信公众号网页授权（可选，不填则退化为匿名采集）-----
MP_APPID=wx1021ba900fb43d2f
MP_SECRET=你的AppSecret

# ----- 公开访问地址（用于微信回调域名推导）-----
PUBLIC_BASE_URL=https://xunxinli.com
